# Server Configuration
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Environment
NODE_ENV=development

# CORS — comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# The site address used to build links in emails, invites and Stripe returns.
# One address, no comma.
APP_URL=http://localhost:3000

# Database
#
# Point this at a DEVELOPMENT database, not production. Every module runs
# ensureSchema() when the server boots, so `npm run dev` issues CREATE TABLE /
# ALTER TABLE against whatever this names — on production that means DDL on live
# customer data.
#
# On Neon the cheapest correct setup is a branch of production: Neon console ->
# Branches -> New branch from main. It is copy-on-write, so it starts as a full
# copy of real data without duplicating storage, and you get a separate
# connection string to paste here.
# DATABASE_URL=postgresql://user:password@localhost:5432/Finquanta_ai

# The production database host, e.g. ep-something-pooler.region.aws.neon.tech
# (host only — no credentials). Naming it here makes the dev server REFUSE to
# start if DATABASE_URL points at it. Leave blank and you only get a warning,
# because a dev branch and a production endpoint are indistinguishable
# otherwise. Set this: it is the whole safety net. The beta API requires it.
# PRODUCTION_DB_HOST=

# Escape hatch for when you genuinely need dev pointed at production. Off unless
# set to exactly 1.
# ALLOW_PROD_DB=1

# JWT — required in production. Any long random string; never reuse between
# production and beta.
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=

# Legacy names, no longer read.
JWT_SECRET=your-secret-key-change-in-production
# API_KEY=your-api-key

# ---------------------------------------------------------------------------
# Beta (beta.finquanta.ai) only
#
# BETA_SITE=true turns on the beta safety checks at boot (assertBetaConfig in
# src/config/config.ts): test-mode Stripe only, DATABASE_URL must not be
# production's, no CRON_SECRET or inbound signing secret. See
# docs/spec-domain-split.md → Beta.
# ---------------------------------------------------------------------------
# BETA_SITE=true
# The production API, ending in /api — where "Import my real books" fetches from.
# PRODUCTION_API_URL=

# PRODUCTION only: the beta site's address. "Import my real books" links there;
# unset, the real site refuses to create import links.
# BETA_SITE_URL=https://beta.finquanta.ai

# ---------------------------------------------------------------------------
# Email (Resend)
#
# Without RESEND_API_KEY nothing is sent; outside production the links are
# logged instead.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# RESET_EMAIL_FROM=Finquanta <no-reply@finquanta.ai>

# Inbound email (receipts forwarded to an address like acme@in.finquanta.ai)
# RESEND_INBOUND_SIGNING_SECRET=
# INBOUND_EMAIL_DOMAIN=in.finquanta.ai
# INBOUND_DAILY_LIMIT=200
# INBOUND_MAX_ATTACHMENTS=20
# INBOUND_ATTACHMENT_HOSTS=resend.com,resend.dev

# Lifecycle reminder emails. Outside production they only send when this is
# set, because a dev database may hold real customers.
# LIFECYCLE_ALLOW_SEND=1

# Shared secret for the scheduled jobs in .github/workflows. Unset, the cron
# routes refuse every call.
# CRON_SECRET=

# ---------------------------------------------------------------------------
# AI (Anthropic)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_ADMIN_KEY=
# CAPTURE_MODEL=
# COUNCIL_MODEL=
# COUNCIL_SYNTHESIS_MODEL=
# COUNCIL_DAILY_LIMIT=3
# COUNCIL_GLOBAL_DAILY_LIMIT=15
# CAPTURE_GLOBAL_DAILY_LIMIT=500
# DEMO_SCAN_IP_DAILY_LIMIT=3
# DEMO_SCAN_GLOBAL_DAILY_LIMIT=100

# ---------------------------------------------------------------------------
# Bot check (Cloudflare Turnstile). Outside production an always-pass test key
# is used when unset; in production every check fails without it.
# ---------------------------------------------------------------------------
# TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# File storage. Anything but s3 keeps files in Postgres.
# ---------------------------------------------------------------------------
# STORAGE_DRIVER=s3
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=
# CAPTURE_PURGE_AFTER_DAYS=30

# ---------------------------------------------------------------------------
# Accounts promoted to staff roles at boot (comma-separated emails)
# ---------------------------------------------------------------------------
# OWNER_EMAILS=
# SUPER_ADMIN_EMAILS=
# ADMIN_EMAILS=
# MODERATOR_EMAILS=

# Error reporting
# SENTRY_DSN=

# Minimum hours between in-app nudges
# NUDGE_MIN_HOURS=

# ---------------------------------------------------------------------------
# Stripe
#
# One price id per plan per interval. The names are derived in code as
# STRIPE_PRICE_<PLAN>_<INTERVAL>, both upper-cased (see stripe.routes.ts
# priceIdFor, and the reverse lookup in webhook.routes.ts), so these names are
# not free-form — a typo makes checkout answer 503 "not available for purchase
# yet" and stops the webhook mapping a paid invoice back to a plan.
#
# Test and live prices are DIFFERENT objects with different ids: keep test ids
# here and set the live ones on Render. Going live is changing values there,
# not editing code.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_ENTREPRENEUR_MONTHLY=price_...
STRIPE_PRICE_ENTREPRENEUR_YEARLY=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_YEARLY=price_...

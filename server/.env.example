# Server Configuration
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Environment
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000

# Database
#
# Point this at a DEVELOPMENT database, not production. Every module runs
# ensureSchema() when the server boots, so `npm run dev` issues CREATE TABLE /
# ALTER TABLE against whatever this names — on production that means DDL on live
# customer data.
#
# On Neon the cheapest correct setup is a branch of production: Neon console ->
# Branches -> New branch from main. It is copy-on-write, so it starts as a full
# copy of real data without duplicating storage, and you get a separate
# connection string to paste here.
# DATABASE_URL=postgresql://user:password@localhost:5432/Finquanta_ai

# The production database host, e.g. ep-something-pooler.region.aws.neon.tech
# (host only — no credentials). Naming it here makes the dev server REFUSE to
# start if DATABASE_URL points at it. Leave blank and you only get a warning,
# because a dev branch and a production endpoint are indistinguishable
# otherwise. Set this: it is the whole safety net.
# PRODUCTION_DB_HOST=

# Escape hatch for when you genuinely need dev pointed at production. Off unless
# set to exactly 1.
# ALLOW_PROD_DB=1

# JWT (if needed later)
JWT_SECRET=your-secret-key-change-in-production

# API Keys (if needed later)
# API_KEY=your-api-key
# ---------------------------------------------------------------------------
# Stripe
#
# One price id per plan per interval. The names are derived in code as
# STRIPE_PRICE_<PLAN>_<INTERVAL>, both upper-cased (see stripe.routes.ts
# priceIdFor, and the reverse lookup in webhook.routes.ts), so these names are
# not free-form — a typo makes checkout answer 503 "not available for purchase
# yet" and stops the webhook mapping a paid invoice back to a plan.
#
# Test and live prices are DIFFERENT objects with different ids: keep test ids
# here and set the live ones on Render. Going live is changing values there,
# not editing code.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_ENTREPRENEUR_MONTHLY=price_...
STRIPE_PRICE_ENTREPRENEUR_YEARLY=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_YEARLY=price_...
